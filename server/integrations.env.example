# Copy to /etc/albina-hair/integrations.env on VPS, NEVER into /var/www or Git.
PUBLIC_ORIGIN=https://albinahair.swiftgifts.tg
PORT=3077
ADMIN_PASSWORD=replace-with-a-unique-long-password-at-least-16-characters
SESSION_SECRET=replace-with-random-32-or-more-characters
DATA_KEY=replace-with-exactly-64-hexadecimal-characters
DATA_FILE=/var/lib/albina-hair/integrations.json

# Register authorized callback:
# https://albinahair.swiftgifts.tg/api/integrations/instagram/callback
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# Register authorized callback:
# https://albinahair.swiftgifts.tg/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook Login for Business / WhatsApp Embedded Signup v4
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
