# Copy to /etc/albina-hair/integrations.env on VPS, NEVER into /var/www or Git.
PUBLIC_ORIGIN=https://albinahair.swiftgifts.tg
PORT=3077
ADMIN_PASSWORD=replace-with-a-unique-long-password-at-least-16-characters
SESSION_SECRET=replace-with-random-32-or-more-characters
DATA_KEY=replace-with-exactly-64-hexadecimal-characters
DATA_FILE=/var/lib/albina-hair/integrations.json

# Register authorized callback:
# https://albinahair.swiftgifts.tg/api/integrations/instagram/callback
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# Register authorized callback:
# https://albinahair.swiftgifts.tg/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook Login for Business / WhatsApp Embedded Signup v4
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=

# CRM: use a dedicated PostgreSQL database and restricted user
REQUIRE_CRM=1
DATABASE_URL=
META_WEBHOOK_VERIFY_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_CHAT_ID=

# Published privacy policy & confirmed DIKIDI booking link; HTTPS only.
# Bot intake is disabled until privacy policy is configured.
TELEGRAM_PRIVACY_URL=
DIKIDI_BOOKING_URL=

# polling for VPS without inbound Telegram connectivity; webhook remains the default.
TELEGRAM_UPDATE_MODE=webhook

# New Meta apps: use shared META_APP_ID and META_APP_SECRET above; IG config is separate from WhatsApp.
INSTAGRAM_LOGIN_MODE=unified
INSTAGRAM_CONFIG_ID=

# Optional DIKIDI booking notifications from a dedicated Gmail account (read-only IMAP)
# DIKIDI_GMAIL_USER=t08029264@gmail.com
# DIKIDI_MAIL_SENDER=verified-sender@example.com
# DIKIDI_GMAIL_APP_PASSWORD=your-16-character-Google-app-password
